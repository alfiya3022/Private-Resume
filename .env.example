
# Application
ENVIRONMENT=development
DEBUG=true

# Required security setting.
# Generate a unique random value for your local .env.
SECRET_KEY=

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL
POSTGRES_USER=private_resume_app
POSTGRES_PASSWORD=
POSTGRES_DB=private_resume
POSTGRES_PORT=5433

# Native backend connection (host machine, not Docker).
# Replace the password placeholder with your local database password.
DATABASE_URL=postgresql+psycopg2://private_resume_app:replace_me@127.0.0.1:5433/private_resume

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Storage
STORAGE_DIR=./storage

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
