# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Configuration
POSTGRES_USER=privateresume
POSTGRES_PASSWORD=privateresume_dev
POSTGRES_DB=privateresume
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://privateresume:privateresume_dev@localhost:5432/privateresume

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Storage
STORAGE_DIR=./storage

# CORS Settings (JSON list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
